# ============================================================================
# RepoLens 配置
# 复制本文件为 .env，然后填入你自己的密钥（三个至少填一个）。
# 不要把这个 .env 上传到 GitHub。
# ============================================================================

# ---- DeepSeek（推荐，便宜好用）----
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 智谱 GLM（和 DeepSeek 二选一即可）----
# 申请地址：https://open.bigmodel.cn/usercenter/apikeys
GLM_API_KEY=
# GLM_MODEL=glm-4.7
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# ---- OpenAI ----
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- 可选：强制指定供应商（auto / deepseek / glm / openai）----
# MODEL_PROVIDER=auto
# MODEL_TEMPERATURE=0.3
# 单次模型请求超时（秒）
# MODEL_TIMEOUT=180

# ---- 可选：Web 服务 ----
# REPOLENS_HOST=127.0.0.1
# REPOLENS_PORT=8765

# ---- 可选：白名单。留空表示允许扫描本机任意目录（本地学习场景默认值）。
# 如果想让项目更安全，可以限定只能扫描这些目录（逗号分隔）：
# REPOLENS_ALLOWED_ROOTS=C:\Users\me\projects,D:\code

# ---- 可选：GitHub 克隆限制 ----
# REPOLENS_MAX_CLONE_MB=300
# REPOLENS_CLONE_TIMEOUT=180

# ---- 可选：LangSmith 追踪（教程第 3 章）。
# 填了之后，Agent 的每一步调用都会记录到 https://smith.langchain.com
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=repolens
